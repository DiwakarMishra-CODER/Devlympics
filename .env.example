# Saathi environment variables. Copy to .env.local and fill in.

# Supabase (lib/supabase.js). Public by design: the browser uses these.
# Use the publishable/anon key, never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI route /api/saathi (lib/providers.js). SERVER ONLY, never NEXT_PUBLIC_.
# Each may hold several keys separated by commas; a rejected key falls through to the next.
GROQ_API_KEY=
GEMINI_API_KEY=
TOKENHARBOR_API_KEY=
