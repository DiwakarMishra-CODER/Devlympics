# Saathi Supabase Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Note: Never commit .env.local or expose service role keys in client code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Saathi AI route (server only, never NEXT_PUBLIC_)
GROQ_API_KEY=
GEMINI_API_KEY=
TOKENHARBOR_API_KEY=
